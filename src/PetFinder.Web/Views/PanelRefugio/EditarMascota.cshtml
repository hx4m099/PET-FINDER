@model PetFinder.Web.ViewModels.MascotaRefugioViewModel
@using PetFinder.Entity.Enums
@{
    ViewData["Title"] = Model.Id.HasValue ? "Editar publicación" : "Publicar mascota";
}
<section class="form-page container"><div class="section-heading"><span class="eyebrow">Publicación del refugio</span><h1>@ViewData["Title"]</h1><p>Cuéntales a las familias por qué esta mascota busca un hogar.</p></div><form asp-action="GuardarMascota" method="post" class="form-card"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><div class="row g-3">
    <div class="col-md-6"><label asp-for="Nombre" class="form-label"></label><input asp-for="Nombre" class="form-control" /><span asp-validation-for="Nombre" class="field-error"></span></div>
    <div class="col-md-6"><label asp-for="Especie" class="form-label"></label><select asp-for="Especie" asp-items="Html.GetEnumSelectList<Especie>()" class="form-select"></select></div>
    <div class="col-md-6"><label asp-for="Raza" class="form-label"></label><input asp-for="Raza" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="EdadMeses" class="form-label">Edad (meses)</label><input asp-for="EdadMeses" class="form-control" min="0" /></div>
    <div class="col-md-6"><label asp-for="Ciudad" class="form-label"></label><input asp-for="Ciudad" class="form-control" /></div>
    <div class="col-md-6"><label asp-for="FotoUrl" class="form-label"></label><input asp-for="FotoUrl" class="form-control" placeholder="https://…" /></div>
    <div class="col-12"><label asp-for="Descripcion" class="form-label"></label><textarea asp-for="Descripcion" class="form-control" rows="4"></textarea></div>
    <div class="col-12 form-check ms-2"><input asp-for="DisponibleAdopcion" class="form-check-input" /><label asp-for="DisponibleAdopcion" class="form-check-label">Disponible para adopción</label></div>
</div><div class="d-flex gap-3 mt-4"><button type="submit" class="btn btn-primary">Guardar</button><a asp-action="Index" class="btn btn-soft">Volver</a></div></form></section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
