@model PetFinder.Web.ViewModels.PanelAdministradorViewModel
@{
    ViewData["Title"] = "Panel de administración";
}
<section class="section container"><div class="section-heading"><span class="eyebrow">Gestión de la comunidad</span><h1>Panel de administración</h1><p>Consulta cuentas y refugios aliados y gestiona su estado.</p></div>
    @if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success" role="status">@mensaje</div> }
    <div class="row g-3 dashboard-stats"><div class="col-sm-6 col-lg-3"><div class="stat-card"><span>Usuarios</span><strong>@Model.TotalUsuarios</strong><small>@Model.UsuariosActivos activos</small></div></div><div class="col-sm-6 col-lg-3"><div class="stat-card"><span>Refugios</span><strong>@Model.TotalRefugios</strong><small>@Model.RefugiosActivos activos</small></div></div></div>
    <div class="admin-section"><h2>Cuentas</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Nombre</th><th>Correo</th><th>Rol</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach (var usuario in Model.Usuarios){<tr><td>@usuario.NombreCompleto</td><td>@usuario.CorreoElectronico</td><td>@usuario.Rol</td><td>@(usuario.Activo ? "Activo" : "Suspendido")</td><td>@if (usuario.Id != Guid.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)!.Value)){<form asp-action="CambiarEstadoUsuario" asp-route-id="@usuario.Id" asp-route-activo="@(!usuario.Activo)" method="post"><button class="btn btn-sm @(usuario.Activo ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(usuario.Activo ? "Suspender" : "Reactivar")</button></form>}</td></tr>}</tbody></table></div></div>
    <div class="admin-section"><h2>Refugios aliados</h2><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Refugio</th><th>Ciudad</th><th>Correo</th><th>Estado</th><th>Acción</th></tr></thead><tbody>@foreach (var refugio in Model.Refugios){<tr><td>@refugio.Nombre</td><td>@refugio.Ciudad</td><td>@refugio.CorreoElectronico</td><td>@(refugio.Activo ? "Activo" : "Suspendido")</td><td><form asp-action="CambiarEstadoRefugio" asp-route-id="@refugio.Id" asp-route-activo="@(!refugio.Activo)" method="post"><button class="btn btn-sm @(refugio.Activo ? "btn-outline-danger" : "btn-outline-success")" type="submit">@(refugio.Activo ? "Suspender" : "Reactivar")</button></form></td></tr>}</tbody></table></div></div>
</section>
