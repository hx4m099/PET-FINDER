@model PetFinder.Web.ViewModels.RegistroViewModel
@{
    ViewData["Title"] = "Crear cuenta";
}
<section class="auth-wrap container">
    <div class="auth-card">
        <span class="eyebrow">Comienza por aquí</span>
        <h1>Crea tu cuenta</h1>
        <p>Publica reportes y coordina visitas a refugios aliados.</p>
        <form asp-action="Registrar" method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-floating"><input asp-for="NombreCompleto" class="form-control" placeholder="Nombre completo" autocomplete="name" /><label asp-for="NombreCompleto"></label><span asp-validation-for="NombreCompleto" class="field-error"></span></div>
            <div class="form-floating"><input asp-for="CorreoElectronico" class="form-control" placeholder="nombre@correo.com" autocomplete="email" /><label asp-for="CorreoElectronico"></label><span asp-validation-for="CorreoElectronico" class="field-error"></span></div>
            <div class="form-floating"><input asp-for="Contrasena" class="form-control" placeholder="Contraseña" autocomplete="new-password" /><label asp-for="Contrasena"></label><span asp-validation-for="Contrasena" class="field-error"></span></div>
            <div class="form-floating"><input asp-for="ConfirmarContrasena" class="form-control" placeholder="Confirmar contraseña" autocomplete="new-password" /><label asp-for="ConfirmarContrasena"></label><span asp-validation-for="ConfirmarContrasena" class="field-error"></span></div>
            <button class="btn btn-primary btn-lg w-100" type="submit">Crear cuenta</button>
        </form>
        <p class="auth-footer">¿Ya tienes cuenta? <a asp-action="Ingresar">Inicia sesión</a></p>
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
