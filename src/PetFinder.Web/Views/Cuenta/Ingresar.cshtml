@model PetFinder.Web.ViewModels.InicioSesionViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
}
<section class="auth-wrap container">
    <div class="auth-card">
        <span class="eyebrow">Qué bueno verte</span>
        <h1>Inicia sesión</h1>
        <p>Vuelve a conectar con tu comunidad PetFinder.</p>
        <form asp-action="Ingresar" method="post" class="form-stack">
            <input asp-for="ReturnUrl" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
            <div class="form-floating"><input asp-for="CorreoElectronico" class="form-control" placeholder="nombre@correo.com" autocomplete="email" /><label asp-for="CorreoElectronico"></label><span asp-validation-for="CorreoElectronico" class="field-error"></span></div>
            <div class="form-floating"><input asp-for="Contrasena" class="form-control" placeholder="Contraseña" autocomplete="current-password" /><label asp-for="Contrasena"></label><span asp-validation-for="Contrasena" class="field-error"></span></div>
            <button class="btn btn-primary btn-lg w-100" type="submit">Entrar a mi cuenta</button>
        </form>
        <p class="auth-footer">¿Aún no tienes cuenta? <a asp-action="Registrar">Regístrate aquí</a></p>
        @if (Context.RequestServices.GetRequiredService<IWebHostEnvironment>().IsDevelopment())
        {
            <hr /><a class="btn btn-outline-secondary w-100" asp-action="Demo">Usar acceso de demostración local</a>
            <small class="text-muted d-block mt-2">El acceso demo solo funciona en Development; las cuentas seed no tienen contraseña.</small>
        }
    </div>
</section>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
