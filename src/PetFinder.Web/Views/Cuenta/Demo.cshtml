@model PetFinder.Web.ViewModels.DemoLoginViewModel
@using PetFinder.Entity.Enums
@{
    ViewData["Title"] = "Acceso local de demostración";
}
<section class="auth-wrap container"><div class="auth-card">
    <span class="eyebrow">Solo entorno Development</span>
    <h1>Explora los roles demo</h1>
    <p>Esto crea una cookie local con una identidad seed. Las cuentas demo no tienen contraseña y este acceso se desactiva fuera de Development.</p>
    <form asp-action="Demo" method="post" class="form-stack">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Rol" class="form-label">Ingresar como</label>
        <select asp-for="Rol" asp-items="Html.GetEnumSelectList<Rol>()" class="form-select"></select>
        <button class="btn btn-primary btn-lg w-100" type="submit">Crear sesión local</button>
    </form>
</div></section>
